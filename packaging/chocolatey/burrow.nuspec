  <metadata>
    <id>burrow</id>
    <version>0.1.0</version>
    <title>Burrow</title>
    <authors>vanshcodeworks</authors>
    <owners>vanshcodeworks</owners>
    <projectUrl>https://github.com/vanshcodeworks/burrow</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/vanshcodeworks/burrow/main/docs/assets/burrow-icon.png</iconUrl>
    <licenseUrl>https://github.com/vanshcodeworks/burrow/blob/main/LICENSE-MIT</licenseUrl>
