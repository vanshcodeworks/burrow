<?xml version="1.0" encoding="UTF-8"?>
<!--
  Burrow MSI installer source (WiX Toolset v3, draft - not yet built).
  Build:
    candle.exe burrow.wxs -dBuildDir="..\..\target\release\"
    light.exe burrow.wixobj -out burrow.msi -ext WixUIExtension
  The BuildDir variable must contain burrow.exe produced by a release build.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Burrow"
           Language="1033"
           Version="0.2.0"
           Manufacturer="vanshcodeworks"
           UpgradeCode="198DD3A0-025A-40AC-BF30-08F7CFCDD5AF">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             Description="Native Windows local development environment manager"
             Manufacturer="vanshcodeworks" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Burrow is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs entries -->
    <Property Id="ARPCOMMENTS" Value="Native Windows local development environment manager" />
    <Property Id="ARPCONTACT" Value="vanshcodeworks" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/vanshcodeworks/burrow" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/vanshcodeworks/burrow/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/vanshcodeworks/burrow" />
    <Property Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Per-user install: %LOCALAPPDATA%\vanshcodeworks\Burrow -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="VanshCodeworksDir" Name="vanshcodeworks">
          <Directory Id="INSTALLDIR" Name="Burrow">
            <Component Id="BurrowExecutable" Guid="8CA070B0-F941-4591-B5CA-299349329C2C">
              <File Id="BurrowExe" Source="$(var.BuildDir)burrow.exe" KeyPath="yes" Vital="yes" />
              <RegistryValue Root="HKCU"
                             Key="Software\vanshcodeworks\Burrow"
                             Name="InstallPath"
                             Type="string"
                             Value="[INSTALLDIR]" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <!-- vanshcodeworks\Burrow Start Menu folder -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="VanshCodeworksMenu" Name="vanshcodeworks">
          <Directory Id="BurrowMenu" Name="Burrow">
            <Component Id="BurrowStartMenuShortcut" Guid="0F77DE76-3698-45C6-A133-F9CA4F9D6EC3">
              <Shortcut Id="StartMenuBurrow"
                        Name="Burrow"
                        Description="Native Windows local development environment manager"
                        Target="[INSTALLDIR]burrow.exe"
                        WorkingDirectory="INSTALLDIR" />
              <RemoveFolder Id="RemoveBurrowMenu" Directory="BurrowMenu" On="uninstall" />
              <RemoveFolder Id="RemoveVanshCodeworksMenu" Directory="VanshCodeworksMenu" On="uninstall" />
              <RegistryValue Root="HKCU"
                             Key="Software\vanshcodeworks\Burrow"
                             Name="StartMenuShortcut"
                             Type="integer"
                             Value="1"
                             KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Burrow" Level="1">
      <ComponentRef Id="BurrowExecutable" />
      <ComponentRef Id="BurrowStartMenuShortcut" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Product>
</Wix>
